{
  "name": "sw5e-master-player-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Екран майстра і синхронні листи персонажів для офлайнових сесій SW5e",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "check": "npm run typecheck && npm run test && npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "build": "vite build --config apps/web/vite.config.ts",
    "start": "npm run build && tsx apps/server/src/run.ts",
    "demo": "npm run start"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "minisearch": "^7.2.0"
  }
}
